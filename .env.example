# Supabase public browser configuration (safe to expose, environment-specific)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side aliases used by TanStack Start server functions
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets: configure in the deployment provider, never commit values.
# LOVABLE_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
