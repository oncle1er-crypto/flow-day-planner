{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sjdhvzjaqarlqcqpkfzd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "flow-day-planner",
      "version": "0.1.0",
      "title": "Flow Day Planner"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "Lister les tâches",
        "description": "Liste les tâches de l'utilisateur connecté, avec filtres optionnels par statut et par date d'échéance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtrer sur un statut de tâche.",
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "cancelled",
                "postponed"
              ]
            },
            "due_on": {
              "description": "Échéance exacte (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "due_before": {
              "description": "Échéance avant cette date.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "limit": {
              "default": 25,
              "description": "Nombre maximum de tâches renvoyées.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Créer une tâche",
        "description": "Crée une nouvelle tâche pour l'utilisateur connecté (titre, priorité, échéance, notes).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Titre de la tâche."
            },
            "description": {
              "description": "Description détaillée.",
              "type": "string",
              "maxLength": 2000
            },
            "priority": {
              "default": "normal",
              "description": "Priorité.",
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high",
                "urgent"
              ]
            },
            "due_date": {
              "description": "Date d'échéance (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "due_time": {
              "description": "Heure d'échéance (HH:MM).",
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "complete_task",
        "title": "Terminer une tâche",
        "description": "Marque une tâche de l'utilisateur connecté comme terminée (ou la remet à faire).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identifiant de la tâche."
            },
            "done": {
              "default": true,
              "description": "true = terminée, false = à faire.",
              "type": "boolean"
            }
          },
          "required": [
            "task_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "daily_summary",
        "title": "Bilan du jour",
        "description": "Renvoie un bilan des tâches de l'utilisateur pour une date donnée (par défaut aujourd'hui) : terminées, en retard, restantes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date": {
              "description": "Date du bilan (YYYY-MM-DD). Par défaut aujourd'hui (UTC).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_habits",
        "title": "Lister les habitudes",
        "description": "Liste les habitudes de l'utilisateur connecté avec leurs journaux récents.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Nombre maximum d'habitudes renvoyées.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
